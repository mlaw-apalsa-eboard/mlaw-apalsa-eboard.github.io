---
interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow } = Astro.props;
---

<header class="page-header">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <slot />
  </div>
</header>

<style>
  .page-header {
    padding-block: var(--space-xl) var(--space-l);
    background:
      linear-gradient(to right, var(--color-maize) 0 4rem, transparent 4rem) bottom left / 100% 4px
        no-repeat,
      var(--color-bg-soft);
    border-bottom: 1px solid var(--color-line);
  }

  h1 {
    font-size: var(--step-4);
    max-width: 22ch;
  }

  .eyebrow {
    margin-bottom: 0.5rem;
  }

  .page-header :global(.lede) {
    margin-top: var(--space-s);
    max-width: 40rem;
    font-size: var(--step-1);
    color: var(--color-muted);
  }
</style>
