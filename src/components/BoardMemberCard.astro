---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  member: CollectionEntry<'board'>['data'];
}

const { name, role, photo, bio } = Astro.props.member;
const initials = name
  .split(/\s+/)
  .map((part) => part[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('');
---

<article class="member">
  <div class="photo">
    {photo ? (
      <Image
        src={photo}
        alt={`Headshot of ${name}`}
        widths={[240, 480]}
        sizes="(min-width: 40rem) 12rem, 40vw"
      />
    ) : (
      <span class="initials" aria-hidden="true">
        {initials}
      </span>
    )}
  </div>
  <div class="details">
    <p class="role">{role}</p>
    <h3>{name}</h3>
    <p class="bio">{bio}</p>
  </div>
</article>

<style>
  .member {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: 9rem 1fr;
    align-items: start;
    padding: var(--space-m);
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
  }

  .photo {
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-blue);
    box-shadow: 0 0 0 4px var(--color-maize-soft);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }

  .initials {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--color-maize);
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 600;
  }

  .role {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-blue-700);
  }

  h3 {
    font-size: var(--step-1);
    margin-block: 0.15rem 0.6rem;
  }

  .bio {
    font-size: 0.95rem;
    color: var(--color-ink);
  }

  @media (max-width: 34rem) {
    .member {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .photo {
      width: 7.5rem;
    }
  }
</style>
