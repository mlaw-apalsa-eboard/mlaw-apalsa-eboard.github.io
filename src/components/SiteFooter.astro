---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import logo from '@/assets/site/logo.webp';
import { NAVIGATION, isGroup } from '@/lib/navigation';
import Icon from './Icon.astro';

interface Props {
  settings: CollectionEntry<'settings'>['data'];
}

const { settings } = Astro.props;
const links = NAVIGATION.flatMap((item) => (isGroup(item) ? item.links : [item]));
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-about">
      <a class="footer-brand" href="/">
        <Image src={logo} alt="" width={56} height={56} densities={[1, 2, 3]} />
        <span>{settings.shortName}</span>
      </a>
      <p>{settings.name} at the University of Michigan Law School.</p>
      <address>
        {settings.address.map((line) => (
          <span>{line}</span>
        ))}
      </address>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <h2 class="footer-heading">Explore</h2>
      <ul role="list">
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer-connect">
      <h2 class="footer-heading">Connect</h2>
      <ul role="list">
        <li>
          <a href={`mailto:${settings.email}`}>
            <Icon name="mail" />
            {settings.email}
          </a>
        </li>
        <li>
          <a href={settings.instagram} rel="noopener">
            <Icon name="instagram" />
            Instagram
          </a>
        </li>
        {settings.mailingList && (
          <li>
            <a href={settings.mailingList} rel="noopener">
              <Icon name="list" />
              Join our mailing list
            </a>
          </li>
        )}
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>
      © {year} {settings.shortName}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-blue);
    color: rgb(255 255 255 / 0.85);
    padding-top: var(--space-xl);
    font-size: 0.95rem;
  }

  .footer-grid {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .footer-about p {
    margin-block: var(--space-s);
    max-width: 22rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #fff;
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
  }

  /* The logo is navy; render it white on the dark footer. */
  .footer-brand img {
    width: 3.5rem;
    height: 3.5rem;
    filter: brightness(0) invert(1);
  }

  address {
    display: flex;
    flex-direction: column;
    font-style: normal;
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-maize);
    margin-bottom: var(--space-s);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  a {
    color: #fff;
    text-decoration: none;
  }

  ul a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    overflow-wrap: anywhere;
  }

  ul a:hover {
    text-decoration: underline;
  }

  .footer-bottom {
    margin-top: var(--space-l);
    padding-block: var(--space-m);
    border-top: 1px solid rgb(255 255 255 / 0.15);
    font-size: var(--step--1);
    color: rgb(255 255 255 / 0.65);
  }
</style>
