---
import { Image } from 'astro:assets';
import logo from '@/assets/site/logo.webp';
import { NAVIGATION, isCurrent, isGroup } from '@/lib/navigation';
import Icon from './Icon.astro';

interface Props {
  name: string;
  shortName: string;
}

const { name, shortName } = Astro.props;
const { pathname } = Astro.url;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <Image src={logo} alt="" width={48} height={48} densities={[1, 2, 3]} loading="eager" />
      <span class="brand-text">
        <span class="brand-name">{shortName}</span>
        <span class="brand-sub">{name}</span>
      </span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <Icon name="menu" class="icon icon-open" />
      <Icon name="close" class="icon icon-close" />
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul class="nav-list" role="list">
        {NAVIGATION.map((item) =>
          isGroup(item) ? (
            <li class="nav-item">
              <details class="nav-group" data-nav-group>
                <summary
                  class:list={[
                    'nav-link',
                    { active: item.links.some((link) => isCurrent(link.href, pathname)) },
                  ]}
                >
                  {item.label}
                  <Icon name="chevronDown" class="icon chevron" />
                </summary>
                <ul class="nav-menu" role="list">
                  {item.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        aria-current={isCurrent(link.href, pathname) ? 'page' : undefined}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li class="nav-item">
              <a
                class="nav-link"
                href={item.href}
                aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const groups = [...document.querySelectorAll<HTMLDetailsElement>('[data-nav-group]')];

  const setMenuOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('menu-open', open);
  };

  toggle?.addEventListener('click', () => {
    setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Only one dropdown open at a time.
  for (const group of groups) {
    group.addEventListener('toggle', () => {
      if (!group.open) return;
      for (const other of groups) if (other !== group) other.open = false;
    });
  }

  // Close dropdowns on outside click or Escape.
  document.addEventListener('click', (event) => {
    for (const group of groups) {
      if (group.open && !group.contains(event.target as Node)) group.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = groups.find((group) => group.open);
    if (open) {
      open.open = false;
      open.querySelector('summary')?.focus();
    } else if (header?.classList.contains('menu-open')) {
      setMenuOpen(false);
      toggle?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: 4.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-blue);
  }

  .brand img {
    width: 3rem;
    height: 3rem;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: clamp(1.0625rem, 0.85rem + 1vw, 1.25rem);
    font-weight: 700;
    text-wrap: balance;
  }

  .brand-sub {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .nav-list,
  .nav-menu {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .nav-link::-webkit-details-marker {
    display: none;
  }

  .nav-link:hover,
  .nav-group[open] > .nav-link {
    background: var(--color-bg-soft);
  }

  .nav-link.active,
  .nav-link[aria-current='page'] {
    color: var(--color-blue);
    box-shadow: inset 0 -3px 0 var(--color-maize);
  }

  .nav-link :global(.chevron) {
    width: 1rem;
    height: 1rem;
    transition: transform 150ms ease;
  }

  .nav-group[open] :global(.chevron) {
    transform: rotate(180deg);
  }

  .nav-menu a {
    display: block;
    padding: 0.55rem 0.9rem;
    border-radius: 0.4rem;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-menu a:hover {
    background: var(--color-bg-soft);
  }

  .nav-menu a[aria-current='page'] {
    color: var(--color-blue);
    font-weight: 600;
    background: var(--color-maize-soft);
  }

  .menu-toggle {
    display: none;
  }

  /* Desktop: inline nav with dropdowns */
  @media (min-width: 56.01rem) {
    .nav-list {
      display: flex;
      gap: 0.25rem;
    }

    .nav-item {
      position: relative;
    }

    .nav-menu {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      min-width: 14rem;
      padding: 0.4rem;
      background: #fff;
      border: 1px solid var(--color-line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }
  }

  /* Mobile: collapsible panel, groups listed openly */
  @media (max-width: 56rem) {
    .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid var(--color-line);
      border-radius: 0.5rem;
      background: #fff;
      color: var(--color-blue);
      cursor: pointer;
    }

    .menu-toggle :global(.icon-close),
    .menu-open .menu-toggle :global(.icon-open) {
      display: none;
    }

    .menu-open .menu-toggle :global(.icon-close) {
      display: block;
    }

    .site-nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      max-height: calc(100vh - 4.5rem);
      overflow-y: auto;
      padding: var(--space-xs) var(--gutter) var(--space-m);
      background: #fff;
      border-bottom: 1px solid var(--color-line);
      box-shadow: var(--shadow);
    }

    .menu-open .site-nav {
      display: block;
    }

    .nav-item + .nav-item {
      border-top: 1px solid var(--color-line);
    }

    .nav-link {
      padding: 0.85rem 0.25rem;
      font-size: 1.0625rem;
    }

    .nav-link.active {
      box-shadow: none;
    }

    .nav-menu {
      padding: 0 0 0.5rem 0.75rem;
    }
  }

  @media (max-width: 40rem) {
    .brand-sub {
      display: none;
    }
  }
</style>
