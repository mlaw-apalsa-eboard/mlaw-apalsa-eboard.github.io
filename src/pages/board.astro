---
import { getCollection } from 'astro:content';
import BoardMemberCard from '@/components/BoardMemberCard.astro';
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { compareBoardMembers } from '@/lib/board';
import { getPage } from '@/lib/content';

const { title, description, Content } = await getPage('board');
const members = (await getCollection('board')).map((entry) => entry.data).sort(compareBoardMembers);
---

<BaseLayout title={title} description={description}>
  <PageHeader title={title} eyebrow="About">
    <div class="lede">
      <Content />
    </div>
  </PageHeader>
  <section class="section">
    <div class="container">
      <h2 class="visually-hidden">Board members</h2>
      <div class="members">
        {members.map((member) => (
          <BoardMemberCard member={member} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .members {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 32rem), 1fr));
  }
</style>
